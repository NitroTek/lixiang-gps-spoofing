<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:id="@+id/app_title" android:visibility="gone"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textColor="#152236" android:textSize="30sp" android:textStyle="bold" />
        <!-- Kept intact for restoring the full interface later. -->
        <LinearLayout android:id="@+id/advanced_controls" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/mode_label" android:labelFor="@+id/mode" android:textSize="17sp" />
        <Spinner android:id="@id/mode" android:layout_width="match_parent" android:layout_height="56dp"
            android:spinnerMode="dropdown" />
        <LinearLayout android:id="@+id/route_controls" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="@string/route_label"
                android:labelFor="@+id/route_choice" android:textSize="17sp" />
            <Spinner android:id="@id/route_choice" android:layout_width="match_parent"
                android:layout_height="56dp" android:spinnerMode="dropdown" />
            <Button android:id="@+id/random_sprint" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/random_sprint" />
        </LinearLayout>
        <TextView android:id="@+id/mode_description" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/route_description" android:textSize="17sp" />
        <LinearLayout android:id="@+id/speed_controls" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/speed_label" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="32dp" android:textSize="24sp" android:textStyle="bold" />
        <SeekBar android:id="@+id/speed" android:layout_width="match_parent" android:layout_height="64dp"
            android:contentDescription="@string/speed_hint" android:max="200" android:progress="90" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/speed_hint" android:textSize="15sp" />
        </LinearLayout>
        <TextView android:id="@+id/accuracy_label" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:textSize="20sp" android:labelFor="@+id/accuracy" />
        <SeekBar android:id="@id/accuracy" android:layout_width="match_parent"
            android:layout_height="56dp" android:max="5" android:progress="5"
            android:contentDescription="@string/accuracy_hint" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/accuracy_hint" android:textSize="15sp" />
        <TextView android:id="@+id/vertical_accuracy_label" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="@string/vertical_accuracy_title" android:textSize="20sp" android:labelFor="@+id/vertical_accuracy" />
        <SeekBar android:id="@id/vertical_accuracy" android:layout_width="match_parent"
            android:layout_height="56dp" android:contentDescription="@string/vertical_accuracy_title" />
        <TextView android:id="@+id/speed_accuracy_label" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="@string/speed_accuracy_title" android:textSize="20sp" android:labelFor="@+id/speed_accuracy" />
        <SeekBar android:id="@id/speed_accuracy" android:layout_width="match_parent"
            android:layout_height="56dp" android:contentDescription="@string/speed_accuracy_title" />
        <TextView android:id="@+id/bearing_accuracy_label" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="@string/bearing_accuracy_title" android:textSize="20sp" android:labelFor="@+id/bearing_accuracy" />
        <SeekBar android:id="@id/bearing_accuracy" android:layout_width="match_parent"
            android:layout_height="56dp" android:contentDescription="@string/bearing_accuracy_title" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/extra_accuracy_description" android:textSize="15sp" />
        <TextView android:id="@+id/extra_accuracy_hint" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="@string/extra_accuracy_unsupported" android:textSize="15sp" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/timer_settings" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <Switch android:id="@+id/timer_enabled" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="56dp" android:layout_marginTop="24dp" android:text="@string/timer_toggle"
            android:textSize="17sp" />
        <LinearLayout android:id="@+id/timer_controls" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/timer_label" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:textSize="20sp" />
            <SeekBar android:id="@+id/timer_duration" android:layout_width="match_parent" android:layout_height="56dp"
                android:max="299" android:progress="19" android:contentDescription="@string/timer_hint" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/timer_hint" android:textSize="15sp" />
        </LinearLayout>
        </LinearLayout>
        <Button android:id="@+id/start_stop" android:layout_width="match_parent" android:layout_height="64dp"
            android:layout_marginTop="24dp" android:enabled="false" android:text="@string/start" />
        <TextView android:id="@+id/timer_countdown" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textSize="18sp" android:visibility="gone" />
        <LinearLayout android:id="@+id/details_controls" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:accessibilityLiveRegion="polite"
            android:text="@string/loading" android:textSize="18sp" />
        <ProgressBar android:id="@+id/route_progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:max="1000" />
        <TextView android:id="@+id/progress_label" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textSize="16sp" />
        <TextView android:id="@+id/coordinates" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:fontFamily="monospace" android:textSize="16sp" />
        <TextView android:id="@+id/altitude" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textSize="16sp" android:visibility="gone" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="32dp" android:text="@string/setup_hint" android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
